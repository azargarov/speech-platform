# Host exposure. Keep loopback unless a reverse proxy and API token are configured.
# COMPOSE_PROJECT_NAME=speech-platform
SPEECH_BIND_IP=127.0.0.1
SPEECH_PORT=8080
SPEECH_API_TOKEN=
# Set this to the HTTPS reverse-proxy URL when exposing beyond loopback.
# SPEECH_API_URL=https://speech.example.net

# Existing content-addressed model store. The release digest is fixed by Git.
MODEL_STORE=/srv/speech-platform/models
MODEL_MANIFEST_SHA256=86d87665c1a794b30f99e800e7bc180a7615b82caea88e4b02c22a7214168ff6
TTS_MODEL_MANIFEST_SHA256=04d6e05b69b22568030ac21f494e406ffdf2d06efeeab43cfdb4c21ba8c9bd41
MODEL_READ_GID=988
TTS_MODEL_STORE=/srv/speech-platform/models
TTS_MODEL_READ_GID=988

# Select one host GPU index. The worker sees that GPU as device 0.
STT_GPU_DEVICE=0
TTS_GPU_DEVICE=0
STT_GPU_MEMORY_LIMIT=12g
STT_CPU_LIMIT=4
STT_PIDS_LIMIT=128
STT_STOP_GRACE_PERIOD=15s
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_CPU_LIMIT=1
TTS_GPU_MEMORY_LIMIT=14g
TTS_CPU_LIMIT=4
TTS_PIDS_LIMIT=128
TTS_STOP_GRACE_PERIOD=240s

# Optional Gateway config override; keep deployment-specific configs private.
# GATEWAY_CONFIG=private/deployment/gateway.yaml

# Required in the private .env only for `make plan/install SERVICE=gateway NO_BUILD=1`.
# Pin the already inspected local Gateway image ID; never use a mutable tag alone.
# GATEWAY_EXPECTED_IMAGE_ID=sha256:<64 lowercase hex digits>
# GATEWAY_EXPECTED_SOURCE_REVISION=<full 40 or 64 character Git revision>

# Used only when the Gateway config enables a local Ollama-backed model.
OLLAMA_CONTAINER_NAME=ollama
OLLAMA_NETWORK_NAME=speech-platform_ollama_private

# Read-only preflight storage floor for checkout/build filesystem, in GiB.
INSTALL_MIN_FREE_GIB=20
# Only needed with explicitly enabled cloud inference. Private KEY=value credentials.
# GATEWAY_SECRETS_FILE=private/cloud.env
