# Host exposure. Keep loopback unless a reverse proxy and API token are configured.
# COMPOSE_PROJECT_NAME=speech-platform
SPEECH_BIND_IP=127.0.0.1
SPEECH_PORT=8080
SPEECH_API_TOKEN=
# Set this to the HTTPS reverse-proxy URL when exposing beyond loopback.
# SPEECH_API_URL=https://speech.example.net

# Existing content-addressed model store. The release digest is fixed by Git.
MODEL_STORE=/srv/speech-platform/models
MODEL_MANIFEST_SHA256=86d87665c1a794b30f99e800e7bc180a7615b82caea88e4b02c22a7214168ff6
MODEL_READ_GID=988

# Select one host GPU index. The worker sees that GPU as device 0.
STT_GPU_DEVICE=0
STT_GPU_MEMORY_LIMIT=12g
STT_CPU_LIMIT=4
STT_PIDS_LIMIT=128
STT_STOP_GRACE_PERIOD=15s
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_CPU_LIMIT=1
TTS_MEMORY_LIMIT=256m
TTS_CPU_LIMIT=1
